{
  "name": "vellum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "pnpm --filter @vellum/ui dev",
    "build": "pnpm --filter @vellum/ui build",
    "lint": "pnpm --filter @vellum/ui lint",
    "typecheck": "pnpm --filter @vellum/ui typecheck",
    "test": "pnpm --filter @vellum/ui test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bindings": "cargo test --workspace export_bindings",
    "e2e": "pnpm --filter @vellum/ui e2e"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "prettier": "^3.10.1"
  }
}
