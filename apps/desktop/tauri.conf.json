{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vellum",
  "identifier": "dev.vellum.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @vellum/ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @vellum/ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vellum",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#0f1014"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
